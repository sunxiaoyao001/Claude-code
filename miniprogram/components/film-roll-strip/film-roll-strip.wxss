/* Film strip for switching cameras (§7.2): frosted 88px bar, 64px sample cards, snap to centre. */
.strip {
  height: var(--strip-height);
  /* The frosted bar runs on under the home indicator; the cards stay in the 88px band. */
  padding-bottom: env(safe-area-inset-bottom);
  background-color: var(--strip-bg);
  backdrop-filter: blur(var(--strip-blur));
  -webkit-backdrop-filter: blur(var(--strip-blur));
  border-top: var(--hairline) solid var(--line);
}

.strip--solid {
  background-color: var(--strip-bg-solid);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.strip-scroll {
  width: 100%;
  height: 100%;
  white-space: nowrap;
}

.strip-track {
  display: flex;
  align-items: flex-start;
  height: 100%;
}

/* Half the bar on each side, so the first and last cards can sit in the centre. Spacer elements, not
   padding: WebKit leaves a flex track's end padding out of the scrollable width. */
.strip-spacer {
  flex: none;
  width: calc(50vw - var(--strip-card) / 2);
  height: 100%;
}

.strip-item {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: var(--strip-card);
  margin-left: var(--strip-card-gap);
  /* Room above for the lifted active card: lift + card + gap + name line = 4 + 64 + 6 + 14 = 88. */
  padding-top: var(--strip-card-lift);
  transition: transform var(--dur-micro) var(--ease-out);
}

.strip-item--first {
  margin-left: 0;
}

.strip-item--series {
  margin-left: var(--sp-3);
}

.strip-item--pressed {
  transform: scale(var(--press-scale));
}

.strip-card {
  position: relative;
  width: var(--strip-card);
  height: var(--strip-card);
  border-radius: var(--radius-m);
  overflow: hidden;
  background-color: var(--bg-1);
  border: var(--stroke) solid var(--line);
  box-sizing: border-box;
  transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
}

.strip-item--active .strip-card {
  transform: translateY(calc(-1 * var(--strip-card-lift)));
  border: var(--stroke-accent) solid var(--accent);
}

.strip-thumb {
  display: block;
  width: 100%;
  height: 100%;
}

/* Locked cameras: veiled, with a lock badge in the top-right corner. */
.strip-lock {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: var(--scrim);
}

.strip-lock-icon {
  position: absolute;
  top: var(--sp-0);
  right: var(--sp-0);
  width: var(--strip-badge);
  height: var(--strip-badge);
}

.strip-progress {
  position: absolute;
  left: 0;
  bottom: 0;
  height: var(--stroke-accent);
  background-color: var(--accent);
  transition: width var(--dur-micro) linear;
}

.strip-name {
  margin-top: var(--strip-name-gap);
  max-width: var(--strip-card);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--fs-caption);
  /* A little taller than the type so CJK glyphs are not clipped by the scroll-view. */
  line-height: calc(var(--fs-caption) + var(--stroke-accent));
  color: var(--text-1);
  transition: color var(--dur-base) var(--ease-out);
}

.strip-item--active .strip-name {
  color: var(--text-0);
}
