.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: var(--bg-0);
}

.layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.camera {
  z-index: 0;
}

.gl {
  z-index: 1;
}

/* Status row, vertically aligned with the capsule menu button (top/height set inline). */
.status {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-title {
  font-size: var(--fs-caption);
  color: var(--text-1);
}

/* Controls (§7.2): shutter row above the film strip. */
.controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

/* Side micro buttons ride the frame: inside its bottom corners, just above the L marks
   (corner inset --sp-1 + arm --frame-arm + gap --sp-2 = --sp-5). --frame-* come from the page root. */
.side {
  position: absolute;
  z-index: 10;
  top: calc(var(--frame-bottom) - var(--sp-5) - var(--control-size));
}

.side-left {
  left: calc(var(--frame-x) + var(--sp-2));
}

.side-right {
  right: calc(var(--frame-x) + var(--sp-2));
}

.control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--control-size);
  height: var(--control-size);
  border-radius: 50%;
  border: var(--hairline) solid var(--line);
  background-color: var(--strip-bg);
  transition: background-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out), opacity var(--dur-base) var(--ease-out);
}

.control-pressed {
  background-color: var(--line);
  transform: scale(var(--press-scale));
}

.control-disabled {
  opacity: var(--disabled-opacity);
}

.icon {
  width: var(--icon-size);
  height: var(--icon-size);
}

.notice {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.notice-title {
  font-size: var(--fs-title);
  color: var(--text-0);
}

.notice-body {
  margin-top: var(--sp-1);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--text-1);
}

.notice-action {
  margin-top: var(--sp-3);
  padding: 0 var(--sp-4);
  height: var(--cta-height);
  border-radius: var(--radius-m);
  line-height: var(--cta-height);
  font-size: var(--fs-body);
  color: var(--bg-0);
  background-color: var(--accent);
  transition: transform var(--dur-micro) var(--ease-out);
}

.notice-action-pressed {
  transform: scale(var(--press-scale));
}

.shutter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-2) var(--sp-4);
}

.shutter-slot {
  width: var(--thumb-size);
  height: var(--thumb-size);
}

.thumb {
  width: var(--thumb-size);
  height: var(--thumb-size);
  border-radius: var(--radius-s);
  border: var(--stroke) solid var(--line);
  background-color: var(--bg-1);
  transition: transform var(--dur-micro) var(--ease-out);
}

.thumb-pressed {
  transform: scale(var(--press-scale));
}

.shutter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--shutter-size);
  height: var(--shutter-size);
  border-radius: 50%;
  border: var(--shutter-ring) solid var(--text-0);
  box-sizing: border-box;
  transition: transform var(--dur-micro) var(--ease-out), opacity var(--dur-base) var(--ease-out);
}

.shutter-core {
  width: calc(100% - 2 * var(--shutter-inset));
  height: calc(100% - 2 * var(--shutter-inset));
  border-radius: 50%;
  background-color: var(--text-0);
}

.shutter-pressed {
  transform: scale(var(--shutter-press-scale));
}

.shutter-busy {
  opacity: var(--disabled-opacity);
}

/* One dark frame when the shutter fires, like a mirror slapping up. */
.mirror-flash {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background-color: var(--bg-0);
}

/* Hidden export canvas: only its backing store matters. */
.export-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: var(--hairline);
  height: var(--hairline);
  opacity: 0;
  z-index: -1;
  pointer-events: none;
}

.viewer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-0);
}

.viewer-image {
  flex: 1;
  width: 100%;
  margin-top: calc(var(--sp-6) * 2);
}

.viewer-actions {
  display: flex;
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-3) + env(safe-area-inset-bottom));
}

.viewer-action {
  flex: 1;
  height: var(--cta-height);
  border-radius: var(--radius-m);
  line-height: var(--cta-height);
  text-align: center;
  font-size: var(--fs-body);
  transition: background-color var(--dur-micro) var(--ease-out), transform var(--dur-micro) var(--ease-out);
}

.viewer-secondary {
  margin-right: var(--sp-1);
  color: var(--text-0);
  background-color: var(--bg-2);
}

.viewer-secondary-pressed {
  background-color: var(--line);
  transform: scale(var(--press-scale));
}

.viewer-primary {
  color: var(--bg-0);
  background-color: var(--accent);
}

.viewer-primary-pressed {
  transform: scale(var(--press-scale));
}
